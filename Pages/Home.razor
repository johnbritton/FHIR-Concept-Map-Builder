@page "/"

<PageTitle>Home</PageTitle>

@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations
@inject IJSRuntime JS
@using FHIR_Concept_Map_Builder.Forms
@using Hl7.Fhir.Model
@using Hl7.Fhir.Serialization
@using Task = System.Threading.Tasks.Task;

<MudGrid Class="pa-4">
    <MudItem xs="12" sm="6">
        <MudPaper Class="pa-4">
            <MudSelect T="Mode" Label="Mode" Required="true" RequiredError="Mode is required" @bind-Value="selectedMode" Variant="Variant.Outlined">
                <MudSelectItem Value="Mode.Generic">Generic</MudSelectItem>
                <MudSelectItem Value="Mode.NHSNLinkEncounter">NHSNLink Encounter</MudSelectItem>
                <MudSelectItem Value="Mode.NHSNLinkLocation">NHSNLink Location</MudSelectItem>
            </MudSelect>
            <MudDivider Class="mt-2 mb-2"></MudDivider>
            @if (selectedMode == Mode.Generic)
            {
                <GenericForm Submitted="jsonGenerated"></GenericForm>
            }
            else if(selectedMode == Mode.NHSNLinkEncounter)
            {
                <NHSNLinkEncounterForm Submitted="jsonGenerated"></NHSNLinkEncounterForm>
            }
            else if(selectedMode == Mode.NHSNLinkLocation)
            {
                <NHSNLinkLocationForm Submitted="jsonGenerated"></NHSNLinkLocationForm>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudPaper Class="pa-4">
            <MudTextField @bind-Value="conceptMapJson" ReadOnly="true" Lines="20" MaxLines="50" Sizing="InputSizing.Auto" Label="Generated Concept Map JSON" Variant="Variant.Outlined"></MudTextField>
        </MudPaper>
    </MudItem>
</MudGrid>


@code {
    
    private string conceptMapJson = "";
    private Mode selectedMode = Mode.Generic;

    void jsonGenerated(string json)
    {
        conceptMapJson = json;
        StateHasChanged();
    }

    enum Mode
    {
        Generic,
        NHSNLinkLocation,
        NHSNLinkEncounter
    }
}